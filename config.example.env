# 存储路径（相对路径以项目根目录为基准）
DATA_DIR=./data
# 单视频处理产物：转写、元数据、知识稿和归档记录
SOURCE_OUTPUT_DIR=./source-output
# 最终持续汇总的主题知识库
KNOWLEDGE_BASE_DIR=./knowledge-base
KNOWLEDGE_PROFILE_PATH=./profiles/open.json
# COOKIE_FILE=./cookies.txt
# 实体手机通过局域网连接时设为 0.0.0.0；公网部署建议交给反向代理监听。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 语音转写
STT_PROVIDER=dashscope_flash
STT_BASE_URL=https://dashscope.aliyuncs.com/api/v1
STT_MODEL=qwen3.5-omni-plus
STT_API_KEY=

# 知识稿撰写模型（OpenAI 兼容接口，与 STT 独立）
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_MODEL=your-writing-model
LLM_API_KEY=
# 支持 enable_thinking 参数的模型可关闭思考，避免输出额度全部耗在推理上
LLM_ENABLE_THINKING=false
# STT 使用百炼密钥时，也可用此变量代替 STT_API_KEY
DASHSCOPE_API_KEY=

# 处理参数
# 同时处理的任务数；知识库归档写入会自动串行，避免主题文件和索引互相覆盖
JOB_WORKER_CONCURRENCY=8
AUDIO_CHUNK_SECONDS=900
# 知识稿模型输出上限（Token，不是字数；思考型模型会把额度用于推理，建议给足余量）
KNOWLEDGE_DRAFT_MAX_TOKENS=10000
REQUEST_TIMEOUT_SECONDS=1200
STT_POLL_TIMEOUT_SECONDS=7200
# 归档后自动重构被合并的主题，把相似内容合并成详细讨论（0 关闭）
AUTO_REFACTOR_TOPICS=true
